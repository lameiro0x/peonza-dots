{
  "mode": "light",
  "colors": {
    "background": "#d4bfa8",
    "background-alternate": "#dbc6ae",
    "surface": "#cbb79f",
    "surface-foreground": "#282623",
    "foreground": "#282623",
    "foreground-muted": "#413d38",
    "primary": "#413d38",
    "state-error": "#842543",
    "state-info": "#3d4b59",
    "state-success": "#1c5422",
    "state-warning": "#684100"
  },
  "app": {
    "overlay-header": "linear-gradient(transparent 0%, rgba(219, 198, 174, 0.85) 100%)",
    "overlay-subheader": "linear-gradient(180deg, rgba(219, 198, 174, 0.05) 0%, var(--theme-colors-background) 100%)",
    "scrollbar-size": "8px",
    "scrollbar-handle-background": "rgba(83, 78, 73, 0.3)",
    "scrollbar-handle-hover-background": "rgba(83, 78, 73, 0.55)",
    "scrollbar-handle-active-background": "rgba(83, 78, 73, 0.75)",
    "scrollbar-handle-border-radius": "2px"
  },
  "mantineOverride": {
    "radius": {
      "xs": "calc(2px / 3)",
      "sm": "calc(2px / 2)",
      "md": "calc(2px * 2 / 3)",
      "lg": "2px",
      "xl": "calc(2px * 4 / 3)"
    }
  },
  "stylesheets": ["ryce.css"]
}
