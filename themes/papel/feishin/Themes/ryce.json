{
  "mode": "dark",
  "colors": {
    "background": "#23382f",
    "background-alternate": "#1d3229",
    "surface": "#293f35",
    "surface-foreground": "#f0dbcb",
    "foreground": "#f0dbcb",
    "foreground-muted": "#dbc4b3",
    "primary": "#d5a5d0",
    "state-error": "#ea86af",
    "state-info": "#e2bf76",
    "state-success": "#a2d496",
    "state-warning": "#e6d271"
  },
  "app": {
    "overlay-header": "linear-gradient(transparent 0%, rgba(29, 50, 41, 0.85) 100%)",
    "overlay-subheader": "linear-gradient(180deg, rgba(29, 50, 41, 0.05) 0%, var(--theme-colors-background) 100%)",
    "scrollbar-size": "8px",
    "scrollbar-handle-background": "rgba(192, 169, 153, 0.3)",
    "scrollbar-handle-hover-background": "rgba(192, 169, 153, 0.55)",
    "scrollbar-handle-active-background": "rgba(192, 169, 153, 0.75)",
    "scrollbar-handle-border-radius": "2px"
  },
  "mantineOverride": {
    "radius": {
      "xs": "calc(2px / 3)",
      "sm": "calc(2px / 2)",
      "md": "calc(2px * 2 / 3)",
      "lg": "2px",
      "xl": "calc(2px * 4 / 3)"
    }
  },
  "stylesheets": ["ryce.css"]
}
