# GENERATED by theme/render.py — theme «Papel». Edit theme/templates/cava/config or contracts/themes/papel.json and re-run it.
# cava 1.0, terminal use, theme «Papel»: bars rise through the theme's hues
# (gruvbox and kanagawa in Origen and Ola, greys from shadow to light in Grafito
# and Tinta); bin/ryce-theme sends SIGUSR2 to reload the colours.
# Colours must be quoted: iniparser reads `#` as a comment.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 10

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
background = default
foreground = '#413d38'
gradient = 1
gradient_color_1 = '#514e4b'
gradient_color_2 = '#413d38'
gradient_color_3 = '#413d38'
gradient_color_4 = '#413d38'
gradient_color_5 = '#413d38'
gradient_color_6 = '#282623'

[smoothing]
noise_reduction = 77
