# GENERATED by theme/render.py — theme «Ola». Edit theme/templates/cava/config or contracts/themes/ola.json and re-run it.
# cava 1.0, terminal use, theme «Ola»: bars rise through the theme's hues
# (gruvbox and kanagawa in Origen and Ola, greys from shadow to light in Grafito
# and Tinta); bin/ryce-theme sends SIGUSR2 to reload the colours.
# Colours must be quoted: iniparser reads `#` as a comment.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 10

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
background = default
foreground = '#c8c093'
gradient = 1
gradient_color_1 = '#a09f96'
gradient_color_2 = '#7aa89f'
gradient_color_3 = '#98bb6c'
gradient_color_4 = '#e6c384'
gradient_color_5 = '#a3d4d5'
gradient_color_6 = '#dcd7ba'

[smoothing]
noise_reduction = 77
