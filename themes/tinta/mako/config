# GENERATED by theme/render.py — theme «Tinta». Edit theme/templates/@tinta/mako/config or contracts/themes/tinta.json and re-run it.
# mako 1.11, theme «Tinta». Smoked glass with a hairline, after the monochrome
# manga desktop it copies: the app's name in brackets above the summary, one
# monospace, a 48 px icon and a progress bar as a lighter band. The frame's edges
# are exclusive zones, so `margin` is only the gap. Hyprland slides them in (layer
# rule on "notifications") and blurs behind the panel alpha. Urgency is told
# by weight alone: low is dimmer, critical keeps a brighter edge and stays. Never
# the signal colour: that belongs to waiting AI sessions.
sort=-time
layer=overlay
anchor=top-right
margin=12
width=420
height=180
padding=16,20
outer-margin=0
border-size=1
border-radius=2
background-color=#1a1a1acc
text-color=#f0f0f0
border-color=#3a3a3a
progress-color=over #f0f0f024
font=JetBrainsMono Nerd Font 11
format=<span foreground="#b4b4b4">[ %a ]</span>\n<b>%s</b>\n%b
markup=1
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=2
max-visible=4
default-timeout=6000
ignore-timeout=1

[urgency=low]
text-color=#b4b4b4
border-color=#262626

[urgency=critical]
border-color=#b4b4b4
default-timeout=0

# `makoctl mode -t do-not-disturb` hides everything; history still records it.
[mode=do-not-disturb]
invisible=1
