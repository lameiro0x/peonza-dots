{
  "mode": "dark",
  "colors": {
    "background": "#282828",
    "background-alternate": "#1d2021",
    "surface": "#32302f",
    "surface-foreground": "#ebdbb2",
    "foreground": "#ebdbb2",
    "foreground-muted": "#bdae93",
    "primary": "#d3869b",
    "state-error": "#f25c54",
    "state-info": "#8ec07c",
    "state-success": "#b8bb26",
    "state-warning": "#fabd2f"
  },
  "app": {
    "overlay-header": "linear-gradient(transparent 0%, rgba(29, 32, 33, 0.85) 100%)",
    "overlay-subheader": "linear-gradient(180deg, rgba(29, 32, 33, 0.05) 0%, var(--theme-colors-background) 100%)",
    "scrollbar-size": "8px",
    "scrollbar-handle-background": "rgba(174, 159, 144, 0.3)",
    "scrollbar-handle-hover-background": "rgba(174, 159, 144, 0.55)",
    "scrollbar-handle-active-background": "rgba(174, 159, 144, 0.75)",
    "scrollbar-handle-border-radius": "3px"
  },
  "mantineOverride": {
    "radius": {
      "xs": "calc(3px / 3)",
      "sm": "calc(3px / 2)",
      "md": "calc(3px * 2 / 3)",
      "lg": "3px",
      "xl": "calc(3px * 4 / 3)"
    }
  },
  "stylesheets": ["ryce.css"]
}
