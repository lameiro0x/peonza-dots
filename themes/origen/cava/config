# GENERATED by theme/render.py — theme «Origen». Edit theme/templates/cava/config or contracts/themes/origen.json and re-run it.
# cava 1.0, terminal use, theme «Origen»: bars rise through the theme's hues
# (gruvbox and kanagawa in Origen and Ola, greys from shadow to light in Grafito
# and Tinta); bin/ryce-theme sends SIGUSR2 to reload the colours.
# Colours must be quoted: iniparser reads `#` as a comment.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 10

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
background = default
foreground = '#bdae93'
gradient = 1
gradient_color_1 = '#af9f90'
gradient_color_2 = '#b8bb26'
gradient_color_3 = '#8ec07c'
gradient_color_4 = '#fabd2f'
gradient_color_5 = '#d3869b'
gradient_color_6 = '#ebdbb2'

[smoothing]
noise_reduction = 77
