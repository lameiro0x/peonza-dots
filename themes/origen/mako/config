# GENERATED by theme/render.py — theme «Origen». Edit theme/templates/mako/config or contracts/themes/origen.json and re-run it.
# mako 1.11, theme «Origen». Cards inside the frame (its edges are
# exclusive zones, so `margin` is only the gap): the app's name on a small line
# above the summary, a 48 px icon, the theme's radius and border, a progress bar
# in the theme's media hue. Hyprland slides them in from the right (layer rule on
# the "notifications" namespace) and blurs behind the panel alpha. Urgency is told
# by weight alone: low is dimmer, critical keeps a brighter edge and stays. Never
# the signal colour: that belongs to waiting AI sessions.
sort=-time
layer=overlay
anchor=top-right
margin=8
width=420
height=180
padding=16,20
outer-margin=0
border-size=2
border-radius=3
background-color=#282828f5
text-color=#ebdbb2
border-color=#504945
progress-color=over #d3869b59
font=Martian Mono 11
format=<span size="small" foreground="#bdae93">%a</span>\n<b>%s</b>\n%b
markup=1
icons=1
max-icon-size=48
icon-location=left
icon-border-radius=3
max-visible=4
default-timeout=6000
ignore-timeout=1

[urgency=low]
text-color=#bdae93
border-color=#3c3836

[urgency=critical]
border-color=#bdae93
default-timeout=0

# `makoctl mode -t do-not-disturb` hides everything; history still records it.
[mode=do-not-disturb]
invisible=1
