    "display_min_px": 26
  },
  "geometry": {
    "frame_top": 48,
    "frame_rim": 0,
    "frame_radius": 1,
    "gaps_in": 3,
    "gaps_out": 6,
    "border": 1,
    "rounding": 1,
    "rounding_power": 2.0,
    "pill_radius": 1
  },
  "blur": {
    "enabled": true,
    "size": 2,
    "passes": 1,
    "brightness": 0.8,
    "desk": true
  },
  "motion": {
    "preset": "mecanica",
    "ms": 220,
    "qml_curve": [
      0.25,
      1.0,
      0.5,
      1.0,
      1.0,
      1.0
    ],
    "hypr": {
      "curves": {
        "snap": {
          "type": "bezier",
          "points": [
            [
              0.25,
              1.0
            ],
            [
              0.5,
              1.0
            ]
          ]
        },
        "quick": {
          "type": "bezier",
          "points": [
            [
              0.4,
              0.0
            ],
            [
              0.2,
              1.0
            ]
          ]
        },
        "lin": {
          "type": "bezier",
          "points": [
            [
              0.0,
              0.0
            ],
            [
              1.0,
              1.0
            ]
          ]
        }
      },
      "leaves": {
        "windowsIn": {
          "speed": 2.5,
          "curve": "snap",
          "style": "popin 96%"
        },
        "windowsOut": {
          "speed": 1.5,
          "curve": "lin",
          "style": "popin 96%"
        },
        "windowsMove": {
          "speed": 2.5,
          "curve": "snap"
        },
        "fadeIn": {
          "speed": 2.0,
          "curve": "snap"
        },
        "fadeOut": {
          "speed": 1.5,
          "curve": "lin"
        },
        "fadeSwitch": {
          "speed": 2.0,
          "curve": "snap"
        },
        "fadeDim": {
          "speed": 2.0,
          "curve": "snap"
        },
        "layersIn": {
          "speed": 2.0,
          "curve": "snap",
          "style": "slide top"
        },
        "layersOut": {
          "speed": 1.5,
          "curve": "lin",
          "style": "fade"
        },
        "fadeLayersIn": {
          "speed": 2.0,
          "curve": "snap"
        },
        "fadeLayersOut": {
          "speed": 1.5,
          "curve": "lin"
        },
        "fadePopupsIn": {
          "speed": 1.5,
          "curve": "snap"
        },
        "fadePopupsOut": {
          "speed": 1.0,
          "curve": "lin"
        },
        "workspacesIn": {
          "speed": 3.0,
          "curve": "quick",
          "style": "slide"
        },
        "workspacesOut": {
          "speed": 3.0,
          "curve": "quick",
          "style": "slide"
        },
        "specialWorkspace": {
          "speed": 2.5,
          "curve": "snap",
          "style": "slidevert"
        },
        "border": {
          "speed": 2.0,
          "curve": "snap"
        },
        "zoomFactor": {
          "speed": 3.0,
          "curve": "snap"
        }
      }
    }
  },
  "wallpaper": {
    "scene": "grafito",
    "source": null,
    "focus": [
      0.5,
      0.5
    ],
    "grade": "none",
    "lock_source": null,
    "alternates": [
      "assets/wallpapers/grafito-ondas.jpg",
      "assets/wallpapers/grafito-relieve.jpg"
    ],
    "transition": "wipe",
    "animated": false
  },
  "desktop": {
    "gtk_theme": "adw-gtk3-dark",
    "icon_theme": "ryce-grafito",
    "folder": "#8c8c8c",
    "folder_dark": "#5a5a5a",
    "cursor": "ryce-peonza",
    "ambient": []
  },
  "contrast_floor": {
    "text": 4.5,
    "ui": 3.0
  },
  "scheme": "dark"
}
