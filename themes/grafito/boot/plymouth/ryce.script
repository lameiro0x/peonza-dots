# GENERATED by theme/render.py — theme «Grafito». Edit theme/templates/boot/plymouth/ryce.script or contracts/themes/grafito.json and re-run it.
# The boot splash: the peonza spins on the theme's darkest ground and the disk passphrase is
# asked under it (the busybox encrypt hook hands the prompt to plymouth). Same API as the
# example shipped in /usr/share/plymouth/themes/script/script.script.
#
# The spin is paced for the screen: plymouth's drm renderer drives each monitor in its
# EDID preferred mode (60 Hz on both here, not the AOC's 144) and writes straight into the
# scanout buffer (no page flip, no vblank wait). At the script plugin's default 50 calls a
# second every sixth refresh showed the same frame twice, a 10 Hz stutter; at 60 calls a
# second, one new frame per call, every refresh shows the next instant: 72 frames, one
# turn every 1.2 s, as the desk's peonza.

fun rgb(r, g, b)
  {
    local.c;
    c.r = r / 255;
    c.g = g / 255;
    c.b = b / 255;
    return c;
  }

bg = rgb(0, 0, 0);
ink = rgb(168, 168, 168);
FONT = "Space Grotesk";

Window.SetBackgroundTopColor(bg.r, bg.g, bg.b);
Window.SetBackgroundBottomColor(bg.r, bg.g, bg.b);

center.x = Window.GetX() + Window.GetWidth() / 2;
center.y = Window.GetY() + Window.GetHeight() * 0.42;

#----------------------------------------- The peonza --------------------------------

FRAMES = 72;  # contracts/constants.json peonza_assets.plymouth_frames
for (i = 0; i < FRAMES; i++)
  {
    if (i < 10)
      peonza.frames[i] = Image("plymouth-0" + i + ".png");
    else
      peonza.frames[i] = Image("plymouth-" + i + ".png");
  }
peonza.size = peonza.frames[0].GetWidth();
peonza.sprite = Sprite(peonza.frames[0]);
peonza.sprite.SetPosition(Math.Int(center.x - peonza.size / 2), Math.Int(center.y - peonza.size / 2), 10);
peonza.frame = 0;

fun refresh_callback ()
  {
    peonza.frame = (peonza.frame + 1) % FRAMES;
    peonza.sprite.SetImage(peonza.frames[peonza.frame]);
  }

# 60, not the plugin's 50 (src/plugins/splash/script/plugin.c FRAMES_PER_SECOND): the
# callback runs once per refresh of a 60 Hz screen.
Plymouth.SetRefreshRate(60);
Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- The passphrase --------------------------------

# The hook's own prompt is English ("A password is required to access the root volume"):
# it is replaced by one short Spanish line, drawn at install time (install/boot/images.py
# prompt) because Image.Text garbles every non-ASCII character in the initramfs (its C
# locale): only ASCII may ever reach Image.Text here. Each typed character is one small dot.
prompt.image = Image("prompt.png");
prompt.sprite = Sprite(prompt.image);
prompt.y = Math.Int(center.y + peonza.size / 2 + 48);
prompt.sprite.SetPosition(Math.Int(center.x - prompt.image.GetWidth() / 2), prompt.y, 10);
prompt.sprite.SetOpacity(0);

DOTS_MAX = 40;  # past this the row stops growing; typing still counts
dot.image = Image("dot.png");
dot.step = dot.image.GetWidth() * 2;
dot.y = Math.Int(prompt.y + prompt.image.GetHeight() + 20);
for (i = 0; i < DOTS_MAX; i++)
  {
    dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetOpacity(0);
  }

fun display_password_callback (prompt_text, bullets)
  {
    prompt.sprite.SetOpacity(1);
    local.count = bullets;
    if (count > DOTS_MAX)
      count = DOTS_MAX;
    local.left = center.x - (count * dot.step - dot.image.GetWidth()) / 2;
    for (n = 0; n < DOTS_MAX; n++)
      {
        if (n < count)
          {
            dots[n].sprite.SetPosition(Math.Int(left + n * dot.step), dot.y, 10);
            dots[n].sprite.SetOpacity(1);
          }
        else
          dots[n].sprite.SetOpacity(0);
      }
  }

fun display_normal_callback ()
  {
    prompt.sprite.SetOpacity(0);
    for (n = 0; n < DOTS_MAX; n++)
      dots[n].sprite.SetOpacity(0);
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

#----------------------------------------- Messages --------------------------------

message.sprite = Sprite();
message.sprite.SetPosition(0, 0, 10);

fun display_message_callback (text)
  {
    message.image = Image.Text(text, ink.r, ink.g, ink.b, 0.8, FONT + " 10");
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Math.Int(center.x - message.image.GetWidth() / 2), Math.Int(Window.GetY() + Window.GetHeight() * 0.88), 10);
    message.sprite.SetOpacity(1);
  }

fun hide_message_callback (text)
  {
    message.sprite.SetOpacity(0);
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
