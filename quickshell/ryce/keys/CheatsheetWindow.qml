import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs
import qs as Ryce
import qs.bar

// The keybinding cheat sheet: a card in the middle of the screen over a dimmed desk, the
// binds grouped in three columns, each key a cap in the theme's skin. The data is
// keys/atajos.json, generated by tools/atajos.py from keys/keymap.tsv, so it never shows
// a key that does not exist. Any key or click closes it. KeysRoot loads it while open
// and drops it on `gone()`.
PanelWindow {
    id: win
    property bool shown: false
    signal closeRequested()
    signal gone()

    readonly property string sheetPath: Quickshell.shellDir + "/keys/atajos.json"
    readonly property int columnWidth: 430
    readonly property int pad: 28
    property var groups: []
    property string problem: ""
    // 0 = hidden, 1 = open. Enters on the theme's curve, leaves faster.
    property real p: 0

    // Groups dealt in order into three columns of about the same height (a title is two rows).
    readonly property var columns: {
        const weight = g => g.rows.length + 2;
        const total = groups.reduce((n, g) => n + weight(g), 0);
        const cols = [[], [], []];
        let i = 0;
        let filled = 0;
        for (const g of groups) {
            if (i < 2 && filled > 0 && filled + weight(g) / 2 > total * (i + 1) / 3) i++;
            cols[i].push(g);
            filled += weight(g);
        }
        return cols.filter(c => c.length > 0);
    }

    visible: shown || p > 0
    anchors { top: true; bottom: true; left: true; right: true }
    exclusionMode: ExclusionMode.Ignore
    color: "transparent"

    WlrLayershell.namespace: "qs-keys"
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: shown ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

    onShownChanged: shown ? open() : close()
    Component.onCompleted: if (shown) open()
    function open() {
        leave.stop();
        enter.duration = Ryce.Palette.motionMs;
        enter.start();
    }
    function close() {
        enter.stop();
        leave.duration = Math.round(Ryce.Palette.motionMs * 0.6);
        leave.start();
    }
    NumberAnimation {
        id: enter
        target: win
        property: "p"
        to: 1
        easing.type: Easing.BezierSpline
        easing.bezierCurve: Ryce.Palette.motionCurve
    }
    NumberAnimation {
        id: leave
        target: win
        property: "p"
        to: 0
        easing.type: Easing.InCubic
        onFinished: win.gone()
    }

    FileView {
        path: win.sheetPath
        printErrors: false
        onLoaded: {
            try {
                win.groups = JSON.parse(text()).groups ?? [];
            } catch (e) {
                win.problem = "No se puede leer keys/atajos.json: ejecuta python3 tools/atajos.py";
            }
        }
        onLoadFailed: win.problem = "Falta keys/atajos.json: ejecuta python3 tools/atajos.py"
    }

    Rectangle {
        anchors.fill: parent
        color: Ryce.Palette.bg0
        opacity: 0.85 * win.p      // dense: the desk behind is text too (HUD, Hito, stats)
    }
    MouseArea {
        anchors.fill: parent
        onClicked: win.closeRequested()
    }

    Item {
        anchors.fill: parent
        focus: true
        // Any key closes, except a modifier on its own: SUPER pressed on the way to
        // SUPER+F1 must not close the sheet the bind is about to toggle.
        Keys.onPressed: event => {
            if ([Qt.Key_Super_L, Qt.Key_Super_R, Qt.Key_Meta, Qt.Key_Control, Qt.Key_Shift,
                 Qt.Key_Alt, Qt.Key_AltGr, Qt.Key_CapsLock].includes(event.key)) return;
            event.accepted = true;
            win.closeRequested();
        }
    }

    Rectangle {
        id: card
        anchors.centerIn: parent
        width: body.implicitWidth + 2 * win.pad
        height: body.implicitHeight + 2 * win.pad
        radius: Ryce.Palette.rounding
        // Nearly opaque whatever the theme's panel alpha: the desk widgets behind (Tinta's
        // HUD, Ola's stats) would otherwise read through the rows.
        color: Ryce.Palette.rgba(Ryce.Palette.bg0, Math.max(0.95, Ryce.Palette.alphaPanel))
        border.width: 1
        border.color: Ryce.Palette.line
        opacity: win.p
        scale: 0.97 + 0.03 * win.p

        ColumnLayout {
            id: body
            x: win.pad
            y: win.pad
            spacing: 22

            SectionRule {
                Layout.fillWidth: true
                label: "atajos"
                meta: win.problem !== "" ? win.problem : "Esc o un clic cierra"
                metaColor: win.problem !== "" ? Ryce.Palette.warn : Ryce.Palette.fg2
            }

            Row {
                spacing: 40

                Repeater {
                    model: win.columns

                    Column {
                        id: column
                        required property var modelData
                        width: win.columnWidth
                        spacing: 22

                        Repeater {
                            model: column.modelData

                            Column {
                                id: group
                                required property var modelData
                                width: win.columnWidth
                                spacing: 6

                                SectionRule {
                                    width: parent.width
                                    label: group.modelData.title.toLowerCase()
                                }
                                Repeater {
                                    model: group.modelData.rows

                                    RowLayout {
                                        id: row
                                        required property var modelData
                                        width: win.columnWidth
                                        spacing: 12

                                        Label {
                                            Layout.fillWidth: true
                                            wrapMode: Text.Wrap
                                            maximumLineCount: 2
                                            text: row.modelData.what
                                            color: Ryce.Palette.fg1
                                        }
                                        Row {
                                            spacing: 4

                                            Repeater {
                                                model: row.modelData.keys

                                                Row {
                                                    id: key
                                                    required property string modelData
                                                    required property int index
                                                    spacing: 4

                                                    // Grafito's bare readouts part with its dot, as on its bar.
                                                    Label {
                                                        visible: key.index > 0
                                                        anchors.verticalCenter: parent.verticalCenter
                                                        text: BarUi.skin === "bare" ? "·" : "+"
                                                        color: Ryce.Palette.fg2
                                                        font.pixelSize: Ui.meta
                                                        elide: Text.ElideNone
                                                    }
                                                    Keycap { text: key.modelData }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
