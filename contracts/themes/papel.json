{
  "schema": "ryce.theme/2",
  "id": "papel",
  "name": "Papel",
  "temperature": "warm",
  "tagline": "Sala de lectura: tapete verde, letra de vitela, oro de lámpara y un bermellón de rúbrica que solo avisa.",
  "colors": {
    "bg0": "#1d3229",
    "bg1": "#23382f",
    "bg2": "#293f35",
    "bg3": "#31473d",
    "line": "#485e54",
    "fg0": "#f0dbcb",
    "fg1": "#dbc4b3",
    "fg2": "#c0a999",
    "pill": "#e2bf76",
    "ink_on_pill": "#182b23",
    "dim_on_pill": "#56492f",
    "busy": "#dbc4b3",
    "signal": "#fd6940",
    "signal_dim": "#6c3628",
    "signal_on_pill": "#b02a05",
    "tint": "#e2bf76",
    "ok": "#a2d496",
    "warn": "#e6d271",
    "err": "#ea86af",
    "claude": "#e6a973"
  },
  "hues": {
    "cpu": "#e5b975",
    "mem": "#88d6c6",
    "net": "#9bc4e1",
    "vol": "#e4d27b",
    "media": "#d5a5d0",
    "clock": "#f0dbcb",
    "disk": "#cfac98"
  },
  "alpha": {
    "bar": 1.0,
    "panel": 0.96,
    "tooltip": 0.97,
    "term": 1.0
  },
  "ansi": [
    "#13261e",
    "#e783ac",
    "#98cb8d",
    "#e4c973",
    "#8bbbdd",
    "#c89cd2",
    "#84c9c4",
    "#dbc4b3",
    "#8fa598",
    "#f799be",
    "#afdda5",
    "#f0da8d",
    "#a5cdeb",
    "#d8b1e1",
    "#a0dbd6",
    "#f8ece0"
  ],
  "term": {
    "cursor": "#e2bf76",
    "selection_bg": "#655637",
    "selection_fg": "#f0dbcb",
    "url": "#9bc4e1",
    "claude": "#e6a973",
    "diff_add": "#394f2d",
    "diff_del": "#5c332f",
    "diff_add_word": "#446233",
    "diff_del_word": "#79403c"
  },
  "fonts": {
    "ui": "Literata",
    "display": "EB Garamond",
    "mono": "JetBrainsMono Nerd Font",
    "icon": "JetBrainsMono Nerd Font",
    "display_min_px": 0
  },
  "geometry": {
    "frame_top": 48,
    "frame_rim": 0,
    "frame_radius": 2,
    "gaps_in": 5,
    "gaps_out": 10,
    "border": 1,
    "rounding": 2,
    "rounding_power": 2.0,
    "pill_radius": 2
  },
  "blur": {
    "enabled": true,
    "size": 4,
    "passes": 2,
    "brightness": 0.6,
    "desk": true
  },
  "motion": {
    "preset": "pausada",
    "ms": 360,
    "qml_curve": [
      0.25,
      0.1,
      0.25,
      1.0,
      1.0,
      1.0
    ],
    "hypr": {
      "curves": {
        "page": {
          "type": "bezier",
          "points": [
            [
              0.25,
              0.1
            ],
            [
              0.25,
              1.0
            ]
          ]
        },
        "settle": {
          "type": "bezier",
          "points": [
            [
              0.0,
              0.0
            ],
            [
              0.2,
              1.0
            ]
          ]
        },
        "leave": {
          "type": "bezier",
          "points": [
            [
              0.4,
              0.0
            ],
            [
              1.0,
              1.0
            ]
          ]
        }
      },
      "leaves": {
        "windowsIn": {
          "speed": 3.6,
          "curve": "page",
          "style": "popin 96%"
        },
        "windowsOut": {
          "speed": 2.6,
          "curve": "leave",
          "style": "popin 96%"
        },
        "windowsMove": {
          "speed": 3.6,
          "curve": "page"
        },
        "fadeIn": {
          "speed": 3.6,
          "curve": "settle"
        },
        "fadeOut": {
          "speed": 2.6,
          "curve": "leave"
        },
        "fadeSwitch": {
          "speed": 3.6,
          "curve": "settle"
        },
        "fadeDim": {
          "speed": 4.0,
          "curve": "settle"
        },
        "layersIn": {
          "speed": 3.4,
          "curve": "page",
          "style": "fade"
        },
        "layersOut": {
          "speed": 2.6,
          "curve": "leave",
          "style": "fade"
        },
        "fadeLayersIn": {
          "speed": 3.4,
          "curve": "settle"
        },
        "fadeLayersOut": {
          "speed": 2.6,
          "curve": "leave"
        },
        "fadePopupsIn": {
          "speed": 3.0,
          "curve": "settle"
        },
        "fadePopupsOut": {
          "speed": 2.0,
          "curve": "leave"
        },
        "workspacesIn": {
          "speed": 4.5,
          "curve": "page",
          "style": "fade"
        },
        "workspacesOut": {
          "speed": 4.5,
          "curve": "page",
          "style": "fade"
        },
        "specialWorkspace": {
          "speed": 4.0,
          "curve": "page",
          "style": "fade"
        },
        "border": {
          "speed": 4.0,
          "curve": "settle"
        },
        "zoomFactor": {
          "speed": 4.0,
          "curve": "settle"
        }
      }
    }
  },
  "wallpaper": {
    "scene": "photo",
    "source": "assets/wallpapers/papel.jpg",
    "focus": [
      0.66,
      0.5
    ],
    "grade": "none",
    "lock_source": "assets/wallpapers/papel-lock.jpg",
    "alternates": [],
    "transition": "fade",
    "animated": false
  },
  "desktop": {
    "gtk_theme": "adw-gtk3-dark",
    "icon_theme": "ryce-papel",
    "folder": "#e2bf76",
    "folder_dark": "#a8873f",
    "cursor": "ryce-peonza",
    "ambient": []
  },
  "contrast_floor": {
    "text": 4.5,
    "ui": 3.0
  }
}
