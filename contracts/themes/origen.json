    "rounding": 3,
    "rounding_power": 2.0,
    "pill_radius": 3
  },
  "blur": {
    "enabled": true,
    "size": 4,
    "passes": 2,
    "brightness": 0.45,
    "desk": true
  },
  "motion": {
    "preset": "cine",
    "ms": 420,
    "qml_curve": [
      0.05,
      0.7,
      0.1,
      1.0,
      1.0,
      1.0
    ],
    "hypr": {
      "curves": {
        "decel": {
          "type": "bezier",
          "points": [
            [
              0.05,
              0.7
            ],
            [
              0.1,
              1.0
            ]
          ]
        },
        "accel": {
          "type": "bezier",
          "points": [
            [
              0.3,
              0.0
            ],
            [
              0.8,
              0.15
            ]
          ]
        },
        "std": {
          "type": "bezier",
          "points": [
            [
              0.2,
              0.0
            ],
            [
              0.0,
              1.0
            ]
          ]
        },
        "over": {
          "type": "bezier",
          "points": [
            [
              0.34,
              1.3
            ],
            [
              0.64,
              1.0
            ]
          ]
        }
      },
      "leaves": {
        "windowsIn": {
          "speed": 4.5,
          "curve": "over",
          "style": "popin 80%"
        },
        "windowsOut": {
          "speed": 2.5,
          "curve": "accel",
          "style": "popin 85%"
        },
        "windowsMove": {
          "speed": 4.0,
          "curve": "std"
        },
        "fadeIn": {
          "speed": 3.0,
          "curve": "decel"
        },
        "fadeOut": {
          "speed": 2.0,
          "curve": "accel"
        },
        "fadeSwitch": {
          "speed": 3.0,
          "curve": "std"
        },
        "fadeDim": {
          "speed": 4.0,
          "curve": "std"
        },
        "layersIn": {
          "speed": 3.5,
          "curve": "decel",
          "style": "popin 92%"
        },
        "layersOut": {
          "speed": 2.0,
          "curve": "accel",
          "style": "fade"
        },
        "fadeLayersIn": {
          "speed": 3.0,
          "curve": "decel"
        },
        "fadeLayersOut": {
          "speed": 2.0,
          "curve": "accel"
        },
        "fadePopupsIn": {
          "speed": 2.5,
          "curve": "decel"
        },
        "fadePopupsOut": {
          "speed": 1.5,
          "curve": "accel"
        },
        "workspacesIn": {
          "speed": 5.0,
          "curve": "decel",
          "style": "slidefade 20%"
        },
        "workspacesOut": {
          "speed": 5.0,
          "curve": "decel",
          "style": "slidefade 20%"
        },
        "specialWorkspace": {
          "speed": 4.0,
          "curve": "decel",
          "style": "slidefadevert 15%"
        },
        "border": {
          "speed": 5.0,
          "curve": "std"
        },
        "zoomFactor": {
          "speed": 5.0,
          "curve": "decel"
        }
      }
    }
  },
  "wallpaper": {
    "scene": "photo",
    "source": "assets/wallpapers/origen-ocaso.jpg",
    "focus": [
      0.5,
      0.62
    ],
    "grade": "none",
    "lock_source": "assets/wallpapers/origen-hudson.jpg",
    "alternates": [
      "assets/wallpapers/origen-hudson.jpg"
    ],
    "transition": "grow",
    "animated": false
