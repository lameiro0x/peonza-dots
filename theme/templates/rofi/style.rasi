/* rofi 2.x (native Wayland), theme «{{theme.name}}». The workshop card: on the left
   the theme's art (wallpaper/panel.png, 360x600, cut for this panel) with a warm
   card on top: greeting, clock, date; a readout of uptime and AI sessions at the
   foot, signed with the peonza. On the right the mode tabs, the search line and
   the list; the selected app is a gold card.

   bin/ryce-launcher fills the panel's text at each open (-theme-str) and turns
   the face and the readout on. The clipboard picker (rofi -dmenu, same theme)
   gets the art and the signature only. Never the signal colour. */

* {
    panel:   {{bg1@alpha.panel}};
    card:    {{bg0@0.84}};
    still:   {{bg2}};
    pick:    {{hue.cpu}};
    on-pick: {{ink_on_pill}};
    tab:     {{hue.mem}};
    chip:    {{bg2}};
    edge:    {{line}};
    text:    {{fg0}};
    muted:   {{fg1}};
    mark:    {{fg2}};

    background-color: transparent;
    text-color:       @muted;
    font:             "{{font.ui}} 13";
}

configuration {
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    window-format:       "{t}";
    display-drun:        "{{glyph.uF003B}}  Apps";
    display-window:      "{{glyph.uF10AC}}  Ventanas";
    display-filebrowser: "{{glyph.uF024B}}  Archivos";
    display-run:         "{{glyph.uF07B7}}  Ejecutar";
    hover-select:        true;
    filebrowser {
        directories-first: true;
        command:           "systemd-run --user --scope --slice=app.slice --collect xdg-open";
    }
}

window {
    location:         center;
    anchor:           center;
    width:            900px;
    height:           540px;
    padding:          0px;
    background-color: @panel;
    border:           {{geometry.border}}px;
    border-color:     @edge;
    border-radius:    {{geometry.rounding}}px;
}

mainbox {
    orientation: horizontal;
    spacing:     0px;
    children:    [ still, column ];
}

/* ---- the panel ------------------------------------------------------------
   panel.png is 360x600; the panel is 3:5 too, so `both` scales without
   distortion. bin/ryce-launcher points the url at the stage's or the session's
   theme; this one is the deployed link (the clipboard picker). */
still {
    orientation:      vertical;
    expand:           false;
    width:            324px;
    padding:          14px;
    spacing:          10px;
    background-color: @still;
    background-image: url("~/.local/state/ryce/theme/current/wallpaper/panel.png", both);
    border-radius:    {{geometry.rounding}}px 0px 0px {{geometry.rounding}}px;
    children:         [ face, still-air, readout, signature ];
}

/* bin/ryce-launcher turns the face and the readout on and the blank off, so the
   face takes the panel's free space: rofi 2.0.0 lays out nothing in a box whose
   children ask for more height than it got, and a box sized to its own estimate
   can come out a few pixels short.
   The card sits at the top of it. */
still-air {
    expand: true;
}

face {
    enabled:     false;
    orientation: vertical;
    expand:      true;
    children:    [ card ];
}

card {
    orientation:      vertical;
    expand:           false;
    padding:          14px 18px 16px 18px;
    spacing:          2px;
    background-color: @card;
    border:           0px 0px 0px 3px;
    border-color:     @pick;
    border-radius:    {{geometry.pill_radius}}px;
    children:         [ textbox-greet, clock, textbox-date ];
}

textbox-greet {
    expand:     false;
    font:       "{{font.ui}} 11";
    text-color: @pick;
}

clock {
    orientation: horizontal;
    expand:      false;
    spacing:     0px;
    children:    [ textbox-hh, textbox-sep, textbox-mm, clock-air ];
}

textbox-hh, textbox-sep, textbox-mm {
    expand:     false;
    font:       "{{font.display}} Medium 46";
    text-color: @text;
}

textbox-sep {
    content:    "{{clock.sep}}";
    text-color: @pick;
}

clock-air {
    expand: true;
}

textbox-date {
    expand:     false;
    font:       "{{font.ui}} 11";
    text-color: @muted;
}

readout {
    enabled:          false;
    orientation:      vertical;
    expand:           false;
    padding:          10px 14px;
    spacing:          6px;
    background-color: @card;
    border-radius:    {{geometry.pill_radius}}px;
    children:         [ uptime-row, agents-row ];
}

uptime-row, agents-row {
    orientation: horizontal;
    expand:      false;
    spacing:     10px;
}

uptime-row { children: [ textbox-uptime-label, textbox-uptime ]; }
agents-row { children: [ textbox-agents-label, textbox-agents ]; }

textbox-uptime-label, textbox-agents-label {
    expand:     false;
    font:       "{{font.ui}} 10";
    text-color: @tab;
}

textbox-uptime-label { content: "{{glyph.uF051B}}  encendido"; }
textbox-agents-label { content: "{{glyph.uF06A9}}"; }

textbox-uptime, textbox-agents {
    expand:     true;
    font:       "{{font.ui}} 10";
    text-color: @text;
}

signature {
    orientation:      horizontal;
    expand:           false;
    padding:          8px 14px;
    spacing:          10px;
    background-color: @card;
    border-radius:    {{geometry.pill_radius}}px;
    children:         [ textbox-peonza, textbox-theme ];
}

textbox-peonza {
    expand:         false;
    content:        "{{glyph.peonza}}";
    font:           "Ryce Peonza 17";
    text-color:     @text;
    vertical-align: 0.5;
}

textbox-theme {
    expand:         true;
    content:        "{{theme.name}}";
    font:           "{{font.ui}} 10";
    text-color:     @muted;
    vertical-align: 0.5;
}

/* ---- the list ------------------------------------------------------------- */

column {
    orientation: vertical;
    expand:      true;
    padding:     18px 22px 18px 22px;
    spacing:     14px;
    children:    [ mode-switcher, body ];
}

mode-switcher {
    expand:  false;
    spacing: 6px;
}

button {
    padding:          6px 12px;
    border-radius:    {{geometry.pill_radius}}px;
    font:             "{{font.icon}} 11";
    text-color:       @muted;
    horizontal-align: 0.5;
}

button selected {
    background-color: @chip;
    text-color:       @tab;
}

body {
    orientation: vertical;
    spacing:     10px;
    children:    [ inputbar, message, listview ];
}

/* Search: a line, not a field. */
inputbar {
    padding:      4px 6px 12px 6px;
    spacing:      12px;
    border:       0px 0px 1px 0px;
    border-color: @edge;
    children:     [ textbox-search, entry ];
}

textbox-search {
    expand:         false;
    content:        "{{glyph.magnify}}";
    font:           "{{font.icon}} 14";
    text-color:     @mark;
    vertical-align: 0.5;
}

entry {
    font:              "{{font.ui}} 14";
    text-color:        @text;
    placeholder:       "Buscar";
    placeholder-color: @muted;
    cursor:            text;
    cursor-color:      @text;
    vertical-align:    0.5;
}

message {
    padding:          8px 12px;
    border-radius:    {{geometry.pill_radius}}px;
    background-color: @chip;
}

textbox {
    text-color: @text;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      2px;
    scrollbar:    false;
    fixed-height: true;
    cycle:        true;
    dynamic:      false;
}

element {
    padding:       7px 12px;
    spacing:       14px;
    border-radius: {{geometry.pill_radius}}px;
    text-color:    @muted;
}

element selected {
    background-color: @pick;
    text-color:       @on-pick;
}

element-icon {
    size:           1.5em;
    vertical-align: 0.5;
    text-color:     inherit;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold;
}
