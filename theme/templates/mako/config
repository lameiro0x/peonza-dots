# mako 1.11, theme «{{theme.name}}». Cards inside the frame (its edges are
# exclusive zones, so `margin` is only the gap): the app's name on a small line
# above the summary, a 48 px icon, the theme's radius and border, a progress bar
# in the theme's media hue. Hyprland slides them in from the right (layer rule on
# the "notifications" namespace) and blurs behind the panel alpha. Urgency is told
# by weight alone: low is dimmer, critical keeps a brighter edge and stays. Never
# the signal colour: that belongs to waiting AI sessions.
sort=-time
layer=overlay
anchor=top-right
margin={{geometry.gaps_out}}
width=420
height=180
padding=16,20
outer-margin=0
border-size={{geometry.border}}
border-radius={{geometry.rounding}}
background-color={{bg1@alpha.panel}}
text-color={{fg0}}
border-color={{line}}
progress-color=over {{hue.media@0.35}}
font={{font.ui}} 11
format=<span size="small" foreground="{{fg1}}">%a</span>\n<b>%s</b>\n%b
markup=1
icons=1
max-icon-size=48
icon-location=left
icon-border-radius={{geometry.pill_radius}}
max-visible=4
default-timeout=6000
ignore-timeout=1

[urgency=low]
text-color={{fg1}}
border-color={{bg3}}

[urgency=critical]
border-color={{fg1}}
default-timeout=0

# `makoctl mode -t do-not-disturb` hides everything; history still records it.
[mode=do-not-disturb]
invisible=1
