/* rofi 2.x (native Wayland), theme «{{theme.name}}». A book's contents page read at
   the reading room's green desk: the list on the left set like an index (no fills,
   hairline rules, the chosen entry gilded like the bar's page, names only: no icons),
   and on the right a narrow strip of the theme's art (panel.png) with a label on it:
   greeting, the time in EB Garamond's italic, the date; the readout and the peonza
   signature at its foot. Vellum letters on the desk's green.

   bin/ryce-launcher fills the panel's text at each open (-theme-str) and turns
   the face and the readout on. The clipboard picker (rofi -dmenu, same theme)
   gets the art and the signature only. Never the signal colour. */

* {
    paper:   {{bg0@alpha.panel}};
    label:   {{bg0@0.94}};
    still:   {{bg1}};
    pick:    {{pill}};
    on-pick: {{ink_on_pill}};
    rule:    {{line}};
    text:    {{fg0}};
    muted:   {{fg1}};
    mark:    {{fg2}};
    /* Printed on the pale bookplate (panel.png): the baize's green as ink. */
    plate-ink:   {{bg0}};
    plate-muted: {{line}};

    background-color: transparent;
    text-color:       @muted;
    font:             "{{font.ui}} 12";
}

configuration {
    /* No icons: app icons are full colour (Chromium, KeePassXC, Obsidian) and rofi
       cannot recolour them; an index lists names, in ink. */
    show-icons:          false;
    drun-display-format: "{name}";
    window-format:       "{t}";
    display-drun:        "Apps";
    display-window:      "Ventanas";
    display-filebrowser: "Archivos";
    display-run:         "Ejecutar";
    hover-select:        true;
    filebrowser {
        directories-first: true;
        command:           "systemd-run --user --scope --slice=app.slice --collect xdg-open";
    }
}

window {
    location:         center;
    anchor:           center;
    width:            860px;
    height:           540px;
    padding:          0px;
    background-color: @paper;
    border:           {{geometry.border}}px;
    border-color:     @rule;
    border-radius:    {{geometry.rounding}}px;
}

/* The index first, the picture after it: the other themes open on the art. */
mainbox {
    orientation: horizontal;
    spacing:     0px;
    children:    [ column, side ];
}

/* ---- the index ------------------------------------------------------------ */

column {
    orientation: vertical;
    expand:      true;
    padding:     26px 30px 22px 30px;
    spacing:     16px;
    children:    [ textbox-heading, mode-switcher, body ];
}

textbox-heading {
    expand:     false;
    content:    "Índice";
    font:       "{{font.display}} Italic 24";
    text-color: @text;
}

mode-switcher {
    expand:       false;
    spacing:      22px;
    padding:      0px 0px 10px 0px;
    border:       0px 0px 1px 0px;
    border-color: @rule;
}

button {
    padding:          2px 0px;
    font:             "{{font.ui}} 11";
    text-color:       @mark;
    horizontal-align: 0.0;
}

/* The open section is underlined in vellum, the way a reader marks the chapter. */
button selected {
    border:       0px 0px 2px 0px;
    border-color: @text;
    text-color:   @text;
}

body {
    orientation: vertical;
    spacing:     10px;
    children:    [ inputbar, message, listview ];
}

/* Search: a fleuron (EB Garamond's ❧, in gilt) before the words. */
inputbar {
    padding:  2px 0px 6px 0px;
    spacing:  12px;
    children: [ textbox-search, entry ];
}

textbox-search {
    expand:         false;
    content:        "❧";
    font:           "{{font.display}} Italic 16";
    text-color:     @pick;
    vertical-align: 0.5;
}

entry {
    font:              "{{font.ui}} 13";
    text-color:        @text;
    placeholder:       "buscar";
    placeholder-color: @mark;
    cursor:            text;
    cursor-color:      @text;
    vertical-align:    0.5;
}

message {
    padding:      8px 0px;
    border:       1px 0px;
    border-color: @rule;
}

textbox {
    text-color: @text;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      0px;
    scrollbar:    false;
    fixed-height: true;
    cycle:        true;
    dynamic:      false;
}

element {
    padding:       7px 12px;
    spacing:       14px;
    border:        0px 0px 1px 0px;
    border-color:  {{line@0.55}};
    border-radius: 0px;
    text-color:    @muted;
}

element selected {
    background-color: @pick;
    border-color:     @pick;
    border-radius:    {{geometry.rounding}}px;
    text-color:       @on-pick;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold;
}

/* ---- the bookplate ------------------------------------------------------------
   The strip is the plate (`still`, panel.png) over a foot in the desk's green that
   holds the readout and the signature. The plate box alone carries the picture, so it
   is about as tall as the picture's 3:5 and rofi draws it once: on the whole strip
   (taller than 3:5) rofi repeats it, and a second «EX LIBRIS» showed between the labels.
   bin/ryce-launcher points the url at the stage's or the session's theme; this one is
   the deployed link (the clipboard picker). */
side {
    orientation:      vertical;
    expand:           false;
    width:            264px;
    spacing:          0px;
    background-color: @still;
    border:           0px 0px 0px 1px;
    border-color:     @rule;
    border-radius:    0px {{geometry.rounding}}px {{geometry.rounding}}px 0px;
    children:         [ still, foot ];
}

still {
    orientation:      vertical;
    expand:           true;
    padding:          14px;
    spacing:          10px;
    background-color: @still;
    background-image: url("~/.local/state/ryce/theme/current/wallpaper/panel.png", both);
    children:         [ face, still-air ];
}

foot {
    orientation:      vertical;
    expand:           false;
    padding:          10px 14px 14px 14px;
    spacing:          10px;
    background-color: @still;
    children:         [ readout, signature ];
}

/* bin/ryce-launcher turns the face and the readout on and the blank off, so the
   face takes the plate's free space (rofi 2.0.0 lays out nothing in a box whose
   children ask for more height than it got). */
still-air {
    expand: true;
}

/* The face is the bookplate's inscription, printed on the plate under the peonza and its
   fleuron (panels.py INSCRIPTION), where an ex libris carries its owner's name: no card
   over the art, so «EX LIBRIS» at the top stays whole. Centred, in the baize's green. */
face {
    enabled:     false;
    orientation: vertical;
    expand:      true;
    children:    [ face-air, card ];
}

face-air {
    expand: true;
}

card {
    orientation:      vertical;
    expand:           false;
    padding:          0px 14px 18px 14px;
    spacing:          4px;
    background-color: transparent;
    border:           0px;
    children:         [ greet-row, clock, date-row ];
}

/* Each small line sits in a row of its own, centred between two blanks like the clock.
   Straight in the vertical card, rofi 2.0.0 measured Literata's and EB Garamond's
   textboxes (both variable fonts) as no taller than nothing and set the greeting, the
   hour and the date on one spot; inside a horizontal row they measure right (seen on
   the stage, 2026-11-21; static fonts such as DejaVu stack either way). */
greet-row {
    orientation: horizontal;
    expand:      false;
    children:    [ greet-left, textbox-greet, greet-right ];
}

date-row {
    orientation: horizontal;
    expand:      false;
    children:    [ date-left, textbox-date, date-right ];
}

greet-left, greet-right, date-left, date-right {
    expand: true;
}

textbox-greet, textbox-date {
    expand:           false;
    font:             "{{font.ui}} Italic 10";
    text-color:       @plate-muted;
    horizontal-align: 0.5;
}

clock {
    orientation: horizontal;
    expand:      false;
    spacing:     0px;
    children:    [ clock-left, textbox-hh, textbox-sep, textbox-mm, clock-air ];
}

textbox-hh, textbox-sep, textbox-mm {
    expand:     false;
    font:       "{{font.display}} Italic 30";
    text-color: @plate-ink;
}

textbox-sep {
    content: "{{clock.sep}}";
}

clock-left, clock-air {
    expand: true;
}

readout {
    enabled:          false;
    orientation:      vertical;
    expand:           false;
    padding:          8px 12px;
    spacing:          4px;
    background-color: @label;
    border:           1px;
    border-color:     @rule;
    border-radius:    {{geometry.frame_radius}}px;
    children:         [ uptime-row, agents-row ];
}

uptime-row, agents-row {
    orientation: horizontal;
    expand:      false;
    spacing:     8px;
}

uptime-row { children: [ textbox-uptime-label, textbox-uptime ]; }
agents-row { children: [ textbox-agents-label, textbox-agents ]; }

textbox-uptime-label, textbox-agents-label {
    expand:     false;
    font:       "{{font.ui}} 9";
    text-color: @mark;
}

textbox-uptime-label { content: "encendido"; }
textbox-agents-label { content: "agentes"; }

textbox-uptime, textbox-agents {
    expand:     true;
    font:       "{{font.ui}} 9";
    text-color: @text;
}

signature {
    orientation:      horizontal;
    expand:           false;
    padding:          6px 12px;
    spacing:          10px;
    background-color: @label;
    border:           1px;
    border-color:     @rule;
    border-radius:    {{geometry.frame_radius}}px;
    children:         [ textbox-peonza, textbox-theme ];
}

textbox-peonza {
    expand:         false;
    content:        "{{glyph.peonza}}";
    font:           "Ryce Peonza 15";
    text-color:     @text;
    vertical-align: 0.5;
}

textbox-theme {
    expand:         true;
    content:        "{{theme.name}}";
    font:           "{{font.display}} Italic 12";
    text-color:     @text;
    vertical-align: 0.5;
}
