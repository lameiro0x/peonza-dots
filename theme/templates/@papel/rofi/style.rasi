/* rofi 2.x (native Wayland), theme «{{theme.name}}». A book's contents page: the
   list on the left set like an index (no fills, hairline rules, the chosen entry
   inked as a filled dot would be, names only: no icons), and on the right a narrow strip of the
   wallpaper's dots (panel.png) with a paper label on it: greeting, the time in
   Space Mono Bold as on the Wittgenstein covers, the date; the readout and the
   peonza signature at its foot. Dark ink on paper.

   bin/ryce-launcher fills the panel's text at each open (-theme-str) and turns
   the face and the readout on. The clipboard picker (rofi -dmenu, same theme)
   gets the art and the signature only. Never the signal colour. */

* {
    paper:   {{bg0@alpha.panel}};
    label:   {{bg0@0.94}};
    still:   {{bg1}};
    pick:    {{pill}};
    on-pick: {{ink_on_pill}};
    rule:    {{line}};
    text:    {{fg0}};
    muted:   {{fg1}};
    mark:    {{fg2}};

    background-color: transparent;
    text-color:       @muted;
    font:             "{{font.ui}} 12";
}

configuration {
    /* No icons: app icons are full colour (Chromium, KeePassXC, Obsidian) and rofi
       cannot recolour them; an index lists names, in ink. */
    show-icons:          false;
    drun-display-format: "{name}";
    window-format:       "{t}";
    display-drun:        "Apps";
    display-window:      "Ventanas";
    display-filebrowser: "Archivos";
    display-run:         "Ejecutar";
    hover-select:        true;
    filebrowser {
        directories-first: true;
        command:           "systemd-run --user --scope --slice=app.slice --collect xdg-open";
    }
}

window {
    location:         center;
    anchor:           center;
    width:            860px;
    height:           540px;
    padding:          0px;
    background-color: @paper;
    border:           {{geometry.border}}px;
    border-color:     @rule;
    border-radius:    {{geometry.rounding}}px;
}

/* The index first, the picture after it: the other themes open on the art. */
mainbox {
    orientation: horizontal;
    spacing:     0px;
    children:    [ column, still ];
}

/* ---- the index ------------------------------------------------------------ */

column {
    orientation: vertical;
    expand:      true;
    padding:     26px 30px 22px 30px;
    spacing:     16px;
    children:    [ textbox-heading, mode-switcher, body ];
}

textbox-heading {
    expand:     false;
    content:    "Índice";
    font:       "{{font.display}} Bold 20";
    text-color: @text;
}

mode-switcher {
    expand:       false;
    spacing:      22px;
    padding:      0px 0px 10px 0px;
    border:       0px 0px 1px 0px;
    border-color: @rule;
}

button {
    padding:          2px 0px;
    font:             "{{font.ui}} 11";
    text-color:       @mark;
    horizontal-align: 0.0;
}

/* The open section is underlined in ink, the way a pencil marks the chapter. */
button selected {
    border:       0px 0px 2px 0px;
    border-color: @text;
    text-color:   @text;
}

body {
    orientation: vertical;
    spacing:     10px;
    children:    [ inputbar, message, listview ];
}

/* Search: an em dash and the words, as the cover sets «—». */
inputbar {
    padding:  2px 0px 6px 0px;
    spacing:  12px;
    children: [ textbox-search, entry ];
}

textbox-search {
    expand:         false;
    content:        "—";
    font:           "{{font.display}} Bold 14";
    text-color:     @text;
    vertical-align: 0.5;
}

entry {
    font:              "{{font.ui}} 13";
    text-color:        @text;
    placeholder:       "buscar";
    placeholder-color: @mark;
    cursor:            text;
    cursor-color:      @text;
    vertical-align:    0.5;
}

message {
    padding:      8px 0px;
    border:       1px 0px;
    border-color: @rule;
}

textbox {
    text-color: @text;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      0px;
    scrollbar:    false;
    fixed-height: true;
    cycle:        true;
    dynamic:      false;
}

element {
    padding:       7px 12px;
    spacing:       14px;
    border:        0px 0px 1px 0px;
    border-color:  {{line@0.55}};
    border-radius: 0px;
    text-color:    @muted;
}

element selected {
    background-color: @pick;
    border-color:     @pick;
    border-radius:    {{geometry.rounding}}px;
    text-color:       @on-pick;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    highlight:      bold;
}

/* ---- the strip of dots ------------------------------------------------------
   panel.png is 360x600; the strip is 3:5 too, so `both` scales without
   distortion. bin/ryce-launcher points the url at the stage's or the session's
   theme; this one is the deployed link (the clipboard picker). */
still {
    orientation:      vertical;
    expand:           false;
    width:            264px;
    padding:          14px;
    spacing:          10px;
    background-color: @still;
    background-image: url("~/.local/state/ryce/theme/current/wallpaper/panel.png", both);
    border:           0px 0px 0px 1px;
    border-color:     @rule;
    border-radius:    0px {{geometry.rounding}}px {{geometry.rounding}}px 0px;
    children:         [ face, still-air, readout, signature ];
}

/* bin/ryce-launcher turns the face and the readout on and the blank off, so the
   face takes the strip's free space (rofi 2.0.0 lays out nothing in a box whose
   children ask for more height than it got). The label sits at its top. */
still-air {
    expand: true;
}

face {
    enabled:     false;
    orientation: vertical;
    expand:      true;
    children:    [ card ];
}

card {
    orientation:      vertical;
    expand:           false;
    padding:          12px 14px 14px 14px;
    spacing:          2px;
    background-color: @label;
    border:           1px;
    border-color:     @rule;
    border-radius:    {{geometry.frame_radius}}px;
    children:         [ textbox-greet, clock, textbox-date ];
}

textbox-greet {
    expand:     false;
    font:       "{{font.ui}} 10";
    text-color: @muted;
}

clock {
    orientation: horizontal;
    expand:      false;
    spacing:     0px;
    children:    [ textbox-hh, textbox-sep, textbox-mm, clock-air ];
}

textbox-hh, textbox-sep, textbox-mm {
    expand:     false;
    font:       "{{font.display}} Bold 34";
    text-color: @text;
}

textbox-sep {
    content: "{{clock.sep}}";
}

clock-air {
    expand: true;
}

textbox-date {
    expand:     false;
    font:       "{{font.ui}} 10";
    text-color: @muted;
}

readout {
    enabled:          false;
    orientation:      vertical;
    expand:           false;
    padding:          8px 12px;
    spacing:          4px;
    background-color: @label;
    border:           1px;
    border-color:     @rule;
    border-radius:    {{geometry.frame_radius}}px;
    children:         [ uptime-row, agents-row ];
}

uptime-row, agents-row {
    orientation: horizontal;
    expand:      false;
    spacing:     8px;
}

uptime-row { children: [ textbox-uptime-label, textbox-uptime ]; }
agents-row { children: [ textbox-agents-label, textbox-agents ]; }

textbox-uptime-label, textbox-agents-label {
    expand:     false;
    font:       "{{font.ui}} 9";
    text-color: @mark;
}

textbox-uptime-label { content: "encendido"; }
textbox-agents-label { content: "agentes"; }

textbox-uptime, textbox-agents {
    expand:     true;
    font:       "{{font.ui}} 9";
    text-color: @text;
}

signature {
    orientation:      horizontal;
    expand:           false;
    padding:          6px 12px;
    spacing:          10px;
    background-color: @label;
    border:           1px;
    border-color:     @rule;
    border-radius:    {{geometry.frame_radius}}px;
    children:         [ textbox-peonza, textbox-theme ];
}

textbox-peonza {
    expand:         false;
    content:        "{{glyph.peonza}}";
    font:           "Ryce Peonza 15";
    text-color:     @text;
    vertical-align: 0.5;
}

textbox-theme {
    expand:         true;
    content:        "{{theme.name}}";
    font:           "{{font.display}} Bold 10";
    text-color:     @text;
    vertical-align: 0.5;
}
