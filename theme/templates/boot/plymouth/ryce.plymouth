[Plymouth Theme]
Name=Ryce {{theme.name}}
Description=La peonza girando sobre el negro del tema; la contraseña del disco, debajo.
ModuleName=script
# mkinitcpio's plymouth hook copies this family (fc-match) into the image as Plymouth.ttf.
Font={{font.ui}}

[script]
ImageDir=/usr/share/plymouth/themes/ryce
ScriptFile=/usr/share/plymouth/themes/ryce/ryce.script
