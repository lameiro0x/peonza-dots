# cava 1.0, terminal use, theme «{{theme.name}}»: bars rise through the theme's hues
# (gruvbox and kanagawa in Origen and Ola, greys from shadow to light in Grafito
# and Tinta); bin/ryce-theme sends SIGUSR2 to reload the colours.
# Colours must be quoted: iniparser reads `#` as a comment.
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 10

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo

[color]
background = default
foreground = '{{fg1}}'
gradient = 1
gradient_color_1 = '{{ansi.8}}'
gradient_color_2 = '{{hue.vol}}'
gradient_color_3 = '{{hue.mem}}'
gradient_color_4 = '{{hue.cpu}}'
gradient_color_5 = '{{hue.media}}'
gradient_color_6 = '{{fg0}}'

[smoothing]
noise_reduction = 77
